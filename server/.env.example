# Local AI Affiliate Clipper Backend Configuration
PORT=5000

# 🌟 PRIMARY (DEFAULT): Alibaba Cloud DashScope Qwen API
QWEN_API_KEY=sk-ws-H.DDHMLPY.QlT1.MEUCIFRQZBZ7kiS7GThZtajOKIoApm6ZxL-i_K9ki801UdZ0AiEA7ZVOpTV5wBWDKM0HXTVG_gJhu9VfxkhmKYNV_-NqPyU
QWEN_API_KEY1=your_second_qwen_api_key_here
QWEN_MODEL=qwen-vl-plus
# Jika Anda membuat API Key di dalam sebuah "Workspace" (kunci berawalan sk-ws-), Anda wajib mengisi URL Workspace Anda di sini:
# Contoh: QWEN_BASE_URL=https://ws-2i01ymr3s0xgy8dx.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=

# 🛡️ FALLBACK: Google Gemini API
# Digunakan secara otomatis jika Qwen terkena Rate Limit atau kehabisan token
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional yt-dlp auth fallback for YouTube 429 / "not a bot" checks.
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=./cookies.txt

# Optional downloader fallbacks.
LOW_DATA_MODE=true
