# Local AI Affiliate Clipper Backend Configuration
PORT=5000

# OpenRouter API Key (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Opsional: Tentukan model OpenRouter utama (Default: openrouter/auto)
# Contoh jika deposit: google/gemini-2.5-flash, meta-llama/llama-3.2-11b-vision-instruct, atau openrouter/auto
OPENROUTER_MODEL=openrouter/auto

# Optional yt-dlp auth fallback for YouTube 429 / "not a bot" checks.
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=./cookies.txt

# Optional downloader fallbacks.
LOW_DATA_MODE=true
# RAPIDAPI_KEY=your_rapidapi_key_here
# RAPIDAPI_HOST=yt-api.p.rapidapi.com
# COBALT_API_URL=
# COBALT_API_KEY=your_cobalt_api_key_here

# TTS Voiceover Settings (Fish Audio Direct S2.1 Pro - Voice: RINDI)
TTS_PROVIDER=fish_audio
TTS_VOICE=RINDI
FISH_AUDIO_API_KEY=your_fish_audio_key_here
FISH_AUDIO_MODEL_ID=9c94fb1d0504466898beb87481df9fa1
