# Local AI Affiliate Clipper Backend Configuration
PORT=5000

# 🌟 PRIMARY (DEFAULT): Google Gemini Free API (1,500 requests/day, Google AI Studio)
# Anda bisa menambahkan lebih dari satu API Key untuk Auto-Rotate saat terkena Rate Limit (Error 429)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY1=your_second_gemini_api_key_here
GEMINI_API_KEY2=your_third_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 🛡️ FALLBACK: Aivene API (api.aivene.com)
AIVENE_API_KEY=your_aivene_api_key_here
AIVENE_MODEL=qwen3.8-flash

# Optional yt-dlp auth fallback for YouTube 429 / "not a bot" checks.
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=./cookies.txt

# Optional downloader fallbacks.
LOW_DATA_MODE=true
# RAPIDAPI_KEY=your_rapidapi_key_here
# RAPIDAPI_HOST=yt-api.p.rapidapi.com
# COBALT_API_URL=
# COBALT_API_KEY=your_cobalt_api_key_here
